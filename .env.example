PORT=8000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_WINDOW_MS=900000
AUTH_MAX_IP_ATTEMPTS=30
AUTH_MAX_ACCOUNT_ATTEMPTS=10
AUTH_MAX_CONCURRENT=4
AUTH_MAX_TRACKED_KEYS=10000
# Explicit direct mode also supports Cloud Run: peer-IP budgets may be shared.
# Forwarded headers are ignored. Use trusted-cidrs only with a verified ingress path.
AUTH_PROXY_MODE=direct
AUTH_TRUSTED_PROXY_CIDRS=

MONGO_URI=

JWT_SECREAT_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=1536

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
FRONTEND_URL=http://localhost:5173

TWITTER_ACCESS_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

RECOMMENDER_URL=http://localhost:8001/recommend
RECOMMENDER_HEALTH_URL=http://localhost:8001/health
RECOMMENDER_TIMEOUT_MS=15000
# Local deadline above; for scale-to-zero Cloud Run set RECOMMENDER_TIMEOUT_MS=120000.
# An explicit 15000/60000 overrides the Cloud Run default; do not copy it unchanged.
# none is restricted to loopback development. Use cloud-run on Cloud Run.
RECOMMENDER_AUTH_MODE=none
# Cloud Run: canonical Python service origin, without /recommend or trailing slash.
# If unset in cloud-run mode, derived from RECOMMENDER_URL.
RECOMMENDER_AUDIENCE=
